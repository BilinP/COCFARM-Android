<?xml version="1.0" encoding="utf-8"?>
<!-- COCFARM's one screen, held upright: the logo along the top, the shown page, and where to go along the
     bottom (Home, Settings, History, Log). Held sideways: layout-land. The pages other than Home are
     added in code. The system bars' room is made in code (MainActivity.edgeToEdge): the bar along the
     bottom reaches the screen's edge, under the gesture line, rather than stopping short of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="COCFARM"
            android:src="@drawable/cocfarm_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="COCFARM"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/cf_accent"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/dashboard" />
    </FrameLayout>

    <!-- A hairline over the tabs: the bar is the page's own colour, like the rail sideways -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cf_outline_variant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        style="@style/Widget.COCFARM.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/nav" />
</LinearLayout>
