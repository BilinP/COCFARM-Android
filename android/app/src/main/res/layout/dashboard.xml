<?xml version="1.0" encoding="utf-8"?>
<!-- The Home screen. Two columns side by side on a wide screen (MainActivity.layoutDashboard): what the bot
     is doing with its controls, a problem and an update on the left; what this run has done, what's left
     to set up and the files on the right. One column (the left one first) on a narrow screen. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <!-- Status and controls -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                android:textColor="@color/cf_muted" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                        <TextView
                            android:id="@+id/detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cf_muted"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/start"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="16dp"
                            android:text="Start farming"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart" />

                        <LinearLayout
                            android:id="@+id/controls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pause"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="Pause"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_pause"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/stop"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="Stop"
                                android:textColor="@color/cf_bad"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_stop"
                                app:iconGravity="textStart"
                                app:iconTint="@color/cf_bad"
                                app:strokeColor="@color/cf_bad_container" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:drawablePadding="8dp"
                            android:text="While it farms, the round button over the game pauses it (tap) and stops it (hold). Stop works straight away, even mid-battle."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/cf_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- A problem that stopped the bot, with a next step -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/problem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/cf_bad_container"
                    app:strokeColor="#5A2A30">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/problem_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/cf_on_bad_container" />

                        <TextView
                            android:id="@+id/problem_why"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cf_on_bad_container" />

                        <TextView
                            android:id="@+id/problem_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/cf_bad"
                            android:visibility="gone" />

                        <!-- What the bot saw last, when it gave up: tap to see it whole -->
                        <ImageView
                            android:id="@+id/problem_seen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="What COCFARM saw last"
                            android:maxHeight="220dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/problem_seen_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_horizontal"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/cf_on_bad_container"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/problem_buttons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/problem_more"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Details"
                                android:textColor="@color/cf_on_bad_container" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/problem_report"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Report"
                                android:textColor="@color/cf_on_bad_container" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/problem_fix"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                app:backgroundTint="@color/cf_bad"
                                android:textColor="@color/cf_background" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- A newer COCFARM -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/cf_accent_container"
                    app:strokeColor="#24508A">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/update_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/cf_on_accent_container" />

                        <TextView
                            android:id="@+id/update_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Your settings, pictures and history stay as they are."
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cf_on_accent_container" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/update_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            app:trackCornerRadius="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/update_notes"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="What's new" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/update_get"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Update" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/column2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <!-- This run -->
                <LinearLayout
                    android:id="@+id/session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextAppearance.COCFARM.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:text="This session" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <!-- The goal (Settings: Farming, Goal): how far this run has got, and about when it'll get there -->
                            <LinearLayout
                                android:id="@+id/goal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="14dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="10dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/goal_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                    android:textColor="@color/cf_text" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/goal_bar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="1000"
                                    app:trackCornerRadius="4dp"
                                    app:trackThickness="8dp" />

                                <TextView
                                    android:id="@+id/goal_eta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="@color/cf_muted" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/counts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="14dp"
                                app:dividerColor="@color/cf_outline_variant" />

                            <LinearLayout
                                android:id="@+id/gains"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <TextView
                                android:id="@+id/last_attack"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingBottom="14dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/cf_muted"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- The base being scouted -->
                    <LinearLayout
                        android:id="@+id/base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextAppearance.COCFARM.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="8dp"
                            android:text="Last base scouted" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/base_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:id="@+id/base_picture"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="The last base scouted"
                                        android:scaleType="fitCenter" />

                                    <TextView
                                        android:id="@+id/verdict"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="top|end"
                                        android:layout_margin="12dp"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="5dp"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                                </FrameLayout>

                                <LinearLayout
                                    android:id="@+id/loot"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="4dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="6dp"
                                    android:paddingHorizontal="18dp"
                                    android:paddingBottom="14dp"
                                    android:text="Tap to see what the bot made of it"
                                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                    android:textColor="@color/cf_accent" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Builder base -->
                    <LinearLayout
                        android:id="@+id/builder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextAppearance.COCFARM.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="8dp"
                            android:text="Builder base" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="4dp">

                                <LinearLayout
                                    android:id="@+id/builder_tiles"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />

                                <TextView
                                    android:id="@+id/builder_last"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="14dp"
                                    android:paddingBottom="14dp"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="@color/cf_muted" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Setup checklist: hidden once everything is done -->
                <LinearLayout
                    android:id="@+id/setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.COCFARM.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:text="Get ready" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/steps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="6dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.COCFARM.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="Files and data" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/links"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="24dp"
                    android:text="Not affiliated with, endorsed by, or connected to Supercell. Botting breaks Clash of Clans' terms and can get your account banned."
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/cf_muted" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
