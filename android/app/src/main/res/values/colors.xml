    <color name="cf_background">#0B1220</color>
    <color name="cf_surface">#121B2E</color>
    <color name="cf_surface_high">#1A2540</color>
    <color name="cf_surface_highest">#22304F</color>
    <!-- 3.2:1 on the cards, 3.5:1 on the background: edges of fields and outlined buttons
         (WCAG 1.4.11 asks 3:1). It was #2E3D5E, 1.6:1. Dividers use cf_outline_variant. -->
    <color name="cf_outline">#566A93</color>
    <color name="cf_outline_variant">#1C2840</color>
